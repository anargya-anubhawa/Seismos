# Basis URL data terbuka BMKG (tanpa garis miring di akhir)
BMKG_BASE_URL=https://data.bmkg.go.id/DataMKG/TEWS
# Feed live InaTEWS/BMKG di CDN (diperbarui tiap beberapa detik)
BMKG_CDN_URL=https://cdn.bmkg.go.id
# Lama cache di server (detik). Jangan di bawah 30 agar tidak membebani sumber.
BMKG_CACHE_TTL_SECONDS=60
# Batas waktu satu permintaan ke BMKG (milidetik)
BMKG_TIMEOUT_MS=8000
# Prakiraan cuaca BMKG (endpoint publik api.bmkg.go.id). Kosong = nilai bawaan kode.
BMKG_FORECAST_URL=https://api.bmkg.go.id/publik/prakiraan-cuaca
# Peringatan dini cuaca BMKG (nowcast). Kosong = nilai bawaan kode.
BMKG_NOWCAST_URL=https://www.bmkg.go.id/alerts/nowcast/id
# Lama cache prakiraan/peringatan cuaca di server (detik). Default 900.
BMKG_WEATHER_TTL_SECONDS=900
# Batas waktu satu permintaan cuaca (milidetik). Default 12000.
BMKG_WEATHER_TIMEOUT_MS=12000
# Hanya set 1 bila aplikasi berada di belakang reverse proxy tepercaya.
# Saat 1, header x-forwarded-for/x-real-ip dipakai sebagai kunci pembatas laju.
# Saat 0/kosong, seluruh lalu lintas berbagi satu kuota (tidak bisa dipalsukan).
TRUST_PROXY_HEADERS=0

# MAGMA Indonesia / PVMBG — sumber seismogram gunung api live.
# Endpoint berikut adalah layanan publik yang dipakai situs MAGMA; bentuknya dapat berubah.
MAGMA_BASE_URL=https://magma.esdm.go.id/_api
MAGMA_IMAGE_BASE=https://vsi.esdm.go.id/data/api/public
MAGMA_SITE_URL=https://magma.esdm.go.id
MAGMA_TIMEOUT_MS=12000
# Cache daftar stasiun di server (detik)
MAGMA_CACHE_TTL_SECONDS=60

# --- Pemantauan tsunami BMKG/InaTEWS ---
# Feed WRS terbaru (satu info; bisa berupa gempa biasa, bukan tsunami).
TSUNAMI_DATAGEMPA_URL=https://cdn.bmkg.go.id/datagempa.json
# Halaman riwayat 30 pembaruan peringatan tsunami (dipakai untuk PD-4/pembaruan).
TSUNAMI_HISTORY_URL=https://www.bmkg.go.id/gempabumi/berpotensi-tsunami
# Arsip resmi 30 kejadian tsunami terakhir (InaTEWS). Kosong = nilai bawaan kode.
TSUNAMI_INATEWS_URL=https://cdn.bmkg.go.id/last30tsunamievent.xml
# Interval polling feed WRS (detik). Minimum 30, default 60.
TSUNAMI_POLL_SECONDS=60
# Interval polling halaman riwayat (detik). Minimum 120, default 300.
TSUNAMI_HISTORY_POLL_SECONDS=300
# Batas waktu satu permintaan sumber tsunami (milidetik).
TSUNAMI_TIMEOUT_MS=12000
# Lama menyimpan peringatan yang sudah berakhir (hari).
TSUNAMI_RETENTION_DAYS=90
# Direktori penyimpanan status, langganan push, dan kunci VAPID.
# Gunakan volume persisten di produksi agar dedupe dan langganan tidak hilang.
TSUNAMI_DATA_DIR=.data/tsunami
# Set 1 untuk mematikan polling latar belakang (route API/cron tetap bisa memicu).
TSUNAMI_MONITOR_DISABLED=0
# Isi untuk melindungi POST/GET /api/tsunami/monitor (header x-tsunami-secret
# atau Authorization: Bearer <secret>). Kosong = endpoint terbuka.
TSUNAMI_MONITOR_SECRET=

# --- Web Push tsunami (VAPID) ---
# Alternatif nama kunci publik untuk pemakaian di klien; VAPID_PUBLIC_KEY di
# atas yang diutamakan. Isi salah satu saja.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Kosongkan keduanya agar server membuat pasangan kunci sekali dan menyimpannya
# di TSUNAMI_DATA_DIR. Jangan pernah menaruh private key di kode frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Harus URL https atau alamat mailto yang valid.
VAPID_SUBJECT=https://github.com/anargya-anubhawa/seismos-indonesia

# --- Pemantauan gunung api MAGMA/PVMBG ---
# Interval pemeriksaan sumber resmi (detik). Minimum 120, default 300.
# Tidak ada feed push/CAP publik dari MAGMA, jadi server melakukan polling.
VOLCANO_POLL_SECONDS=300
# Direktori status, antrean notifikasi, dan langganan push gunung api.
# Kunci VAPID TIDAK disimpan di sini: dipakai bersama TSUNAMI_DATA_DIR/vapid.json
# agar satu langganan browser menerima tsunami + gunung api.
# Gunakan volume persisten di produksi agar dedupe dan langganan tidak hilang.
VOLCANO_DATA_DIR=.data/volcano
# Set 1 untuk mematikan polling latar belakang (cron tetap bisa memicu manual).
VOLCANO_MONITOR_DISABLED=0
# Isi untuk melindungi POST /api/volcano/monitor (Authorization: Bearer <secret>
# atau header x-volcano-secret). GET status tetap publik. Kosong = POST terbuka.
VOLCANO_MONITOR_SECRET=
# Batas ukuran berkas gambar MAGMA yang diteruskan proxy (byte). Default 40 MB;
# peta KRB sumber dapat berukuran puluhan MB.
MAGMA_IMAGE_MAX_BYTES=40000000
