# Basis URL data terbuka BMKG (tanpa garis miring di akhir)
BMKG_BASE_URL=https://data.bmkg.go.id/DataMKG/TEWS
# Feed live InaTEWS/BMKG di CDN (diperbarui tiap beberapa detik)
BMKG_CDN_URL=https://cdn.bmkg.go.id
# Lama cache di server (detik). Jangan di bawah 30 agar tidak membebani sumber.
BMKG_CACHE_TTL_SECONDS=60
# Batas waktu satu permintaan ke BMKG (milidetik)
BMKG_TIMEOUT_MS=8000

# MAGMA Indonesia / PVMBG — sumber seismogram gunung api live.
# Endpoint berikut adalah layanan publik yang dipakai situs MAGMA; bentuknya dapat berubah.
MAGMA_BASE_URL=https://magma.esdm.go.id/_api
MAGMA_IMAGE_BASE=https://vsi.esdm.go.id/data/api/public
MAGMA_SITE_URL=https://magma.esdm.go.id
MAGMA_TIMEOUT_MS=12000
# Cache daftar stasiun di server (detik)
MAGMA_CACHE_TTL_SECONDS=60
